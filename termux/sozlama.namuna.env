# Telefondagi ishga tushirish sozlamalari (~/milliy_sertifikat/sozlama.env).
# O'zgartirish:  nano ~/milliy_sertifikat/sozlama.env   so'ng   bio restart

# Tunnel: ngrok (doimiy domen, bepul tarifda oyiga ~20 000 so'rov)
#      yoki cloudflare (cheksiz, lekin har ishga tushganda manzil o'zgaradi — bot o'zi yangilaydi)
TUNNEL=ngrok
NGROK_DOMEN=https://roughy-outgoing-iguana.ngrok-free.app

# Django serveri (faqat telefon ichida, tashqariga tunnel orqali chiqadi)
PORT=8123
ISHCHILAR=2
OQIMLAR=8
